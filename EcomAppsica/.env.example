# ============================================================
# AppsicaEcom Frontend Environment Configuration
# ============================================================

# PRODUCTION (e.g. Vercel Dashboard):
# Set this to your deployed backend URL (Render, Railway, VPS, etc.).
# The API client automatically normalizes this (with or without /api).
# Example: VITE_API_URL=https://your-backend-api.onrender.com
# Example: VITE_API_URL=https://your-backend-api.onrender.com/api
VITE_API_URL=

# LOCAL DEVELOPMENT:
# Leave empty or unset in .env.local so Vite's dev proxy forwards '/api' to http://127.0.0.1:5000

